{
  "name": "@changzhen976/node-red-contrib-statechart",
  "version": "0.7.0-dev.0",
  "description": "State chart editor and runtime for Node-RED — SCXML 1.0 compatible",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/changzhen976/node-red-contrib-statechart.git"
  },
  "bugs": {
    "url": "https://github.com/changzhen976/node-red-contrib-statechart/issues"
  },
  "homepage": "https://github.com/changzhen976/node-red-contrib-statechart#readme",
  "author": {
    "name": "changzhen.liu",
    "email": "changzhen976@gmail.com"
  },
  "engines": {
    "node": ">=22.9"
  },
  "main": "dist/statechart.js",
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES.md",
    "CHANGELOG.md",
    "README.en.md",
    "docs/images",
    "docs/hub-contract.md"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "test": "npm run build && node --test test/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "check:kit": "node scripts/check-kit.mjs",
    "prepack": "npm run build",
    "test:browser": "node test/browser-smoke.mjs",
    "test:p4": "node test/browser-p4.mjs",
    "test:e2e": "node test/e2e-server.mjs",
    "release:check": "node scripts/release-check.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "test:cascade": "node scripts/test-cascade.mjs"
  },
  "node-red": {
    "version": ">=5.0.0",
    "nodes": {
      "statechart": "dist/statechart.js"
    }
  },
  "dependencies": {
    "@tinyactors/scxmljs": "0.2.0-dev.0",
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "node-red": "5.0.9",
    "node-red-node-test-helper": "0.3.6",
    "statechart-kit": "0.10.0",
    "typescript": "^5.9.3",
    "vue": "^3.5.45"
  },
  "keywords": [
    "node-red",
    "state chart",
    "statechart",
    "state machine",
    "scxml",
    "fsm",
    "hierarchical",
    "parallel",
    "history"
  ]
}
