{
  "name": "node-red-contrib-scxmljs",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "SCXML state machines for Node-RED",
  "license": "MIT",
  "author": "changzhen.liu",
  "engines": {
    "node": ">=22.9"
  },
  "main": "dist/scxml.js",
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "test": "npm run build && node --test test/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "sync:vendor": "node scripts/sync-vendor.mjs",
    "check:vendor": "node scripts/check-vendor.mjs",
    "test:browser": "node test/browser-smoke.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "node-red": {
    "version": ">=5.0.0",
    "nodes": {
      "scxml": "dist/scxml.js"
    }
  },
  "dependencies": {
    "@tinyactors/scxmljs": "0.2.0-dev.0",
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "node-red": "5.0.9",
    "node-red-node-test-helper": "0.3.6",
    "typescript": "^5.9.3"
  }
}
