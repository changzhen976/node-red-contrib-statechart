[
  {
    "id": "tab-hub-demo",
    "type": "tab",
    "label": "Hub 低代码演示",
    "disabled": false,
    "info": "状态机中枢 + 事件/变量/复位模块"
  },
  {
    "id": "hubdemo-help",
    "type": "comment",
    "z": "tab-hub-demo",
    "name": "说明",
    "info": "Hub 只选一次状态机；左侧接入事件/变量/复位模块，右侧输出状态、事件、错误。",
    "x": 80,
    "y": 40,
    "wires": []
  },
  {
    "id": "hubdemo-conf",
    "type": "statechart-machine",
    "z": "tab-hub-demo",
    "name": "Hub Demo",
    "doc": "",
    "source": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" datamodel=\"ecmascript\" name=\"Hub Demo\" initial=\"idle\">\n  <datamodel>\n    <data id=\"label\" expr=\"'idle'\"/>\n    <data id=\"count\" expr=\"0\"/>\n  </datamodel>\n  <state id=\"idle\">\n    <transition event=\"start\" target=\"running\"><assign location=\"label\" expr=\"'running'\"/></transition>\n  </state>\n  <state id=\"running\">\n    <transition event=\"stop\" target=\"idle\"><assign location=\"label\" expr=\"'idle'\"/></transition>\n    <transition event=\"bump\">\n      <assign location=\"count\" expr=\"count + 1\"/>\n      <send event=\"bumped\"><content expr=\"{count: count}\"/></send>\n    </transition>\n  </state>\n</scxml>\n",
    "engine": "sandboxed",
    "scriptTimeoutMs": 500,
    "maxMicrosteps": 10000,
    "monitorShowVars": true,
    "persistVars": false,
    "updateEvent": "update",
    "x": 80,
    "y": 520
  },
  {
    "id": "hubdemo-hub",
    "type": "statechart-hub",
    "z": "tab-hub-demo",
    "name": "Hub Demo",
    "machine": "hubdemo-conf",
    "includeVars": true,
    "emitInitial": true,
    "includeInternalSends": false,
    "stateTopic": "",
    "eventTopic": "statechart/{machine}/evt/{event}",
    "x": 440,
    "y": 280,
    "wires": [
      [
        "hubdemo-rec-state"
      ],
      [
        "hubdemo-rec-events"
      ],
      [
        "hubdemo-rec-errors"
      ]
    ]
  },
  {
    "id": "hubdemo-rec-state",
    "type": "function",
    "z": "tab-hub-demo",
    "name": "record state",
    "func": "global.set('hub_demo_state', {states: msg.states, vars: msg.vars, event: msg.event, ts: Date.now()}); return msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 700,
    "y": 180,
    "wires": [
      [
        "hubdemo-dbg-state"
      ]
    ]
  },
  {
    "id": "hubdemo-rec-events",
    "type": "function",
    "z": "tab-hub-demo",
    "name": "record events",
    "func": "const arr=global.get('hub_demo_events')||[]; arr.push({event:msg.event,payload:msg.payload,ts:Date.now()}); if(arr.length>100)arr.splice(0,arr.length-100); global.set('hub_demo_events',arr); return msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 700,
    "y": 260,
    "wires": [
      [
        "hubdemo-dbg-events"
      ]
    ]
  },
  {
    "id": "hubdemo-rec-errors",
    "type": "function",
    "z": "tab-hub-demo",
    "name": "record errors",
    "func": "const arr=global.get('hub_demo_errors')||[]; arr.push({message:msg.payload,ts:Date.now()}); global.set('hub_demo_errors',arr); return msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
