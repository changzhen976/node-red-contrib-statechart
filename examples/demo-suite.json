    "source": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<scxml xmlns=\"http://www.w3.org/2005/07/scxml\" version=\"1.0\" initial=\"session\">\n  <state id=\"session\" initial=\"app\">\n    <state id=\"app\" initial=\"home\">\n      <state id=\"home\"><transition event=\"open\" target=\"details\"/></state>\n      <state id=\"details\"><transition event=\"back\" target=\"home\"/></state>\n      <history id=\"last\" type=\"shallow\"><transition target=\"home\"/></history>\n    </state>\n    <state id=\"paused\"><transition event=\"resume\" target=\"last\"/></state>\n    <state id=\"stopped\"><transition event=\"resume\" target=\"last\"/></state>\n    <transition event=\"pause\" target=\"paused\"/>\n    <transition event=\"stop\" target=\"stopped\"/>\n  </state>\n</scxml>",
